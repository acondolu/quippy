{
  "compilerOptions": {
    "target": "es2016",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2016", "dom"],
    "jsx": "preserve",
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "removeComments": true
  },
  "include": ["./src"]
}
